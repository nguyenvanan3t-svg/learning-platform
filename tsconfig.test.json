{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "lib/math-engine/**/*"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist"
  ]
}